# Application mode
VITE_APP_MODE="PROD" ### TEST | PROD

# Mocks && Logging
VITE_MOCKS="ALWAYS" ### ALWAYS | FALLBACK | DEACTIVATED
VITE_LOGS="DEBUG" ### DEBUG | ACTIVATED | DEACTIVATED

# APIs
VITE_EXCHANGE_API="https://api.frankfurter.dev/v2"
VITE_API_CORE="https://api.example.com"
VITE_API_MESSENGER="https://api.example.com"
VITE_WS_MESSENGER="wss://api.example.com/messaging/ws"
VITE_API_AUTH="https://auth.example.com"
VITE_API_VALIDATION="https://validation.example.com"

# Widget de mapa interativo (Gerência de Unidades) — opcional; sem essa chave,
# o formulário de unidade cai para campos numéricos de latitude/longitude.
VITE_GOOGLE_MAPS_API_KEY=""
