# Todas as variaveis VITE_* sao embutidas no bundle em build-time: nunca coloque segredos aqui.
# Copie para .env.local (nao versionado) para desenvolvimento. QA e producao recebem estes valores no build da CI.

# Modo da aplicacao
# PROD: rotas normais. TEST: expoe as rotas de teste (TestRoutes), so para desenvolvimento.
VITE_APP_MODE="PROD" ### TEST | PROD

# Mocks
# Os padroes abaixo chamam as APIs reais. Os mocks so existem em desenvolvimento (vite dev) e nos testes,
# e so quando ligados aqui de forma explicita. Um build de producao (vite build) ignora estas tres chaves.
# VITE_MOCKS: dados de dominio (catalogo, empresas, perfis). ALWAYS = sempre mock; FALLBACK = API real e, se falhar, mock.
# VITE_AUTH_MOCKS: login e sessao. Sobrepoe VITE_MOCKS so para a autenticacao.
# VITE_MESSENGER_MOCKS: mensagens e tempo real (conversas, digitando, presenca, assistente). Sobrepoe VITE_MOCKS so para o messenger.
VITE_MOCKS="DEACTIVATED" ### ALWAYS | FALLBACK | DEACTIVATED
VITE_AUTH_MOCKS="DEACTIVATED" ### ALWAYS | DEACTIVATED
VITE_MESSENGER_MOCKS="DEACTIVATED" ### ALWAYS | DEACTIVATED
# VITE_AI_MOCKS: servicos de IA (validacao de CNPJ e certificados, assistentes, texto alternativo de imagens). Sobrepoe VITE_MOCKS so para a IA.
# Para o assistente do demandante, use junto com VITE_MESSENGER_MOCKS="ALWAYS": as conversas simuladas vivem no messenger local.
VITE_AI_MOCKS="DEACTIVATED" ### ALWAYS | DEACTIVATED
# Atraso simulado, em segundos, das respostas mockadas.
VITE_MOCKS_DELAY_SECONDS="2"

# Logs
VITE_LOGS="DEBUG" ### DEBUG | ACTIVATED | DEACTIVATED

# APIs (URL base, sem barra no final; o front acrescenta os prefixos de cada rota)
# api-core: dominio (empresas, profissionais, placas, usuarios, conexoes).
VITE_API_CORE="https://api.example.com"
# api-auth: login, cadastro, renovacao de sessao.
VITE_API_AUTH="https://auth.example.com"
# api-messenger (REST): conversas e mensagens, em /messaging.
VITE_API_MESSENGER="https://api.example.com"
# api-messenger (WebSocket STOMP): endereco completo, com ws:// ou wss:// e o caminho /messaging/ws.
VITE_WS_MESSENGER="wss://api.example.com/messaging/ws"
# ai-validation: validacao de CNPJ e de certificados NR-10/NR-35. Exige o Bearer do api-auth; a primeira chamada pode levar de 40 a 100 s (cold start).
VITE_API_VALIDATION="https://validation.example.com"
# API publica de cambio usada pelo conversor de moedas.
VITE_EXCHANGE_API="https://api.frankfurter.dev/v2"

# Widget de mapa interativo (Gerencia de Unidades). Opcional: sem a chave, o formulario de unidade usa
# campos numericos de latitude e longitude. Restrinja a chave por dominio no Google Cloud.
VITE_GOOGLE_MAPS_API_KEY=""

# Link de instalacao do app mobile exibido na pagina de acesso mobile. Opcional.
VITE_MOBILE_INSTALL_URL=""

# Somente desenvolvimento (vite dev)
# Descomente so quando precisar; uma variavel vazia substitui o padrao.
# Destino do proxy /local-api/core do servidor de desenvolvimento. Padrao: http://localhost:8080.
# VITE_LOCAL_API_CORE_TARGET="http://localhost:8080"
# Pre-preenchem o formulario de login em desenvolvimento com uma conta do seed local; fora do vite dev sao ignoradas.
# VITE_DEV_LOGIN_EMAIL=""
# VITE_DEV_LOGIN_PASSWORD=""
