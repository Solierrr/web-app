rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isQaAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/qa_admins/$(request.auth.token.email));
    }

    match /qa_admins/{email} {
      allow read, write: if false;
    }

    match /qa_devices/{fid} {
      allow read, write: if isQaAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
