# Makefile padrao dos repositorios Solierrr.
# Igual em todos os repos: so o bloco "especifico deste repositorio" muda.
# Requer: make e sh (Git Bash no Windows). Para `make vault`: Infisical CLI e `infisical login`.

# ---- especifico deste repositorio ----
VAULT_FOLDERS ?= /vite /service-urls
INSTALL_CMD   ?= npm ci
DEV_CMD       ?= npm run dev
BUILD_CMD     ?= npm run build
TEST_CMD      ?= npm test
LINT_CMD      ?= npm run lint
FORMAT_CMD    ?= npm run format
CLEAN_PATHS   ?= dist storybook-static
DOCTOR_TOOLS  ?= git node npm
# Stack local (banco com seed + api-auth + api-core) vem do database-console, clonado ao lado deste repo.
DATABASE_CONSOLE_DIR ?= ../database-console

# ---- padrao (nao editar por repositorio) ----
INFISICAL_PROJECT_ID ?= 2296d19c-5f3b-41e1-afa3-fcde39966a71
ENV ?= local
OUT ?= .env
# Git Bash converteria '/vite' em 'C:/Program Files/Git/vite' ao chamar o CLI.
export MSYS_NO_PATHCONV := 1
ifeq ($(OS),Windows_NT)
INFISICAL ?= infisical.cmd
else
INFISICAL ?= infisical
endif

.DEFAULT_GOAL := help
.PHONY: help verify-vault vault env dev dev-web stack-up stack-down stack-status local-env install build test lint format clean doctor ci

help: ## Show the available commands
	@awk 'BEGIN {FS = ":.*## "; printf "Usage: make <target>\n\n"} /^[a-zA-Z_-]+:.*## / {printf "  %-14s %s\n", $$1, $$2}' $(MAKEFILE_LIST)

verify-vault: ## Check that the Infisical CLI is installed and authenticated
	@$(INFISICAL) --version >/dev/null 2>&1 || { echo "Infisical CLI not installed. Install it (https://infisical.com/docs/cli/overview) and retry."; exit 1; }
	@$(INFISICAL) user get token --silent >/dev/null 2>&1 || { echo "No active Infisical session. Run 'infisical login' and retry."; exit 1; }
	@echo "OK: Infisical authenticated."

vault: verify-vault ## Write OUT (default .env) from Infisical; ENV=local|qa|prod (default local)
	@case "$(ENV)" in local|qa|prod) ;; *) echo "Invalid ENV '$(ENV)'. Use local, qa or prod (example: make vault ENV=qa)."; exit 1;; esac
	@tmp=$$(mktemp) || exit 1; \
	echo "# Generated by make vault - env=$(ENV) folders=$(VAULT_FOLDERS)" > "$$tmp"; \
	for folder in $(VAULT_FOLDERS); do \
		echo "Extracting $$folder (env=$(ENV))..."; \
		out=$$($(INFISICAL) export --env=$(ENV) --path=$$folder --format=dotenv --projectId=$(INFISICAL_PROJECT_ID) --silent 2>&1) \
			|| { echo "Failed to extract '$$folder' (env=$(ENV)). Check access, environment and path in Infisical."; rm -f "$$tmp"; exit 1; }; \
		if echo "$$out" | grep -q 'serving secrets from last successful fetch'; then \
			echo "Infisical could not reach the server for '$$folder' and returned cached data. $(OUT) was not changed."; rm -f "$$tmp"; exit 1; fi; \
		vars=$$(echo "$$out" | grep -E '^[[:space:]]*(export[[:space:]]+)?[^#[:space:]][^=]*='); \
		if [ -z "$$vars" ]; then \
			echo "No secrets returned for '$$folder' (env=$(ENV)). $(OUT) was not changed."; rm -f "$$tmp"; exit 1; fi; \
		printf '\n# --- %s ---\n%s\n' "$$folder" "$$vars" >> "$$tmp"; \
	done; \
	mv "$$tmp" "$(OUT)" && echo "OK: $(OUT) written (env=$(ENV))."

env: vault ## Alias for vault

dev: stack-up local-env ## Start the local stack (db + seed + APIs) and the dev server
	$(DEV_CMD)

dev-web: ## Start only the dev server (uses whatever APIs your .env points to)
	$(DEV_CMD)

stack-up: ## Start Postgres, Redis, seed, api-auth and api-core (via database-console)
	@test -d "$(DATABASE_CONSOLE_DIR)" || { echo "database-console not found at $(DATABASE_CONSOLE_DIR). Clone it next to this repo or set DATABASE_CONSOLE_DIR."; exit 1; }
	"$(MAKE)" -C "$(DATABASE_CONSOLE_DIR)" dev-up

stack-down: ## Stop the local stack
	"$(MAKE)" -C "$(DATABASE_CONSOLE_DIR)" dev-down

stack-status: ## Show which local services are up
	"$(MAKE)" -C "$(DATABASE_CONSOLE_DIR)" dev-status

# Aponta o web para a stack local sem tocar no .env (o Vite prioriza .env.local).
local-env:
	@if [ -f .env.local ]; then echo ".env.local already exists, keeping it."; else echo '# Stack local (make dev). Sobrepoe o .env; nao versionado.' > .env.local; echo 'VITE_MOCKS="DEACTIVATED"' >> .env.local; echo 'VITE_AUTH_MOCKS="DEACTIVATED"' >> .env.local; echo 'VITE_MESSENGER_MOCKS="ALWAYS"' >> .env.local; echo 'VITE_API_CORE="http://localhost:8080"' >> .env.local; echo 'VITE_API_AUTH="http://localhost:8081"' >> .env.local; echo ".env.local created (APIs locais)."; fi

install: ## Install dependencies
	$(INSTALL_CMD)

build: ## Build the project
	$(BUILD_CMD)

test: ## Run the tests
	$(TEST_CMD)

lint: ## Run the linter
	$(LINT_CMD)

format: ## Format the code
	$(FORMAT_CMD)

clean: ## Remove build outputs (CLEAN_PATHS)
	rm -rf $(CLEAN_PATHS)

doctor: ## Check that the tools this repository needs are available
	@missing=0; 	for tool in make $(DOCTOR_TOOLS); do 		if command -v $$tool >/dev/null 2>&1; then echo "ok       $$tool"; else echo "MISSING  $$tool"; missing=1; fi; 	done; 	if $(INFISICAL) --version >/dev/null 2>&1; then 		if $(INFISICAL) user get token --silent >/dev/null 2>&1; then echo "ok       infisical (logged in)"; else echo "WARN     infisical installed but not logged in (run 'infisical login')"; fi; 	else echo "WARN     infisical not installed (only needed for 'make vault')"; fi; 	exit $$missing

ci: lint test build ## Run lint, test and build in pipeline order
